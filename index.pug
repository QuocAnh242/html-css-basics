      priceFrom: 'From $1,200',
      rating: '4.8',
      reviews: 12,
      duration: '9 hours',
      price: 61
    },
    {
      title: 'Floating markets and countryside tour in Bangkok',
      image: './images/Floating-market.jpg',
      priceFrom: 'From $890',
      rating: '4.7',
      reviews: 18,
      duration: '6 hours',
      price: 49
    },
    {
      title: 'Chiang Mai mountain trek with village visit',
      image: './images/Chiang-Mai.jpg',
      priceFrom: 'From $1,450',
      rating: '4.9',
      reviews: 27,
      duration: '12 hours',
      price: 75
    }
  ]

  const populars = [
    {
      title: 'The Grand Palace',
      image: './images/Grand-Palace.jpg',
      time: 'Sep 28, 10AM - 5PM',
      rating: '4.8',
      reviews: 12,
      duration: '9 hours',
      label: 'Must See'
    },
    {
      title: 'Wat Arun (Temple of Dawn)',
      image: './images/Wat-Arun.jpg',
      time: 'Sep 29, 9AM - 4PM',
      rating: '4.7',
      reviews: 18,
      duration: '6 hours',
      label: 'Recommended'
    },
    {
      title: 'Chatuchak Weekend Market',
      image: './images/Chatuchak.jpg',
      time: 'Sep 30, 8AM - 6PM',
      rating: '4.9',
      reviews: 27,
      duration: '12 hours',
      label: 'Popular'
    },
    {
      title: 'Bangkok Night Market',
      image: './images/Bangkok-Night-Market.jpg',
      time: 'Sep 28, 6PM - 11PM',
      rating: '4.9',
      reviews: 34,
      duration: '8 hours',
      label: 'Night Life'
    }
  ]
doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title HTML Document
    link(rel='stylesheet', href='styles/styles.css')
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='./styles/popular.css')
  body
    h2(style='text-align: left; margin: 20px;') Our Tour Lists
    .tour-wrapper
      .tour-list
        each tour in tours
          +tourCard(tour)
          
    h2(style='text-align: left; margin: 20px;') Popular things to do in Bangkok
    .container 
      .popular-list
        each popular in populars
          +popularItem(popular)