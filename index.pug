doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title HTML CSS Master
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet")
    body
        tour-list
            tour-card
                img.tour-image(src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8M3x8YmVhY2glMjB2YWNhdGlvbnxlbnwwfHwwfHx8&auto=format&fit=crop&w=500&q=60" alt="Beach Vacation")
                .tour-content
                    h2.tour-title Beach Vacation
                    .tour-review
                        span.tour-rating 4.5
                        span.tour-count (200 reviews)
                    p.tour-description Enjoy the sun, sand, and sea with our exclusive beach vacation packages.